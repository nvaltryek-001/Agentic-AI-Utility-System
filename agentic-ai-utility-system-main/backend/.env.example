# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

PORT=5000
NODE_ENV=development

# Database (Local Development)
MONGO_URI=mongodb://127.0.0.1:27017/valtryek_001

# Authentication - CHANGE THESE IN PRODUCTION
JWT_SECRET=your_very_secure_random_jwt_secret_key_here
JWT_REFRESH_SECRET=your_very_secure_random_refresh_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# Frontend
FRONTEND_URL=http://localhost:5173

# Redis (Set to true to enable queue and distributed Socket.io)
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service (Optional - for OTP delivery)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
